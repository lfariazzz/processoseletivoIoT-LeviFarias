  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led_green", "top": -80, "left": -120, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_red", "top": -80, "left": -60, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led_yellow", "top": -80, "left": 0, "attrs": { "color": "yellow" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 150, "left": -150, "attrs": { "color": "green", "label": "F1" } },
    { "type": "wokwi-pushbutton", "id": "btn2", "top": 150, "left": -80, "attrs": { "color": "green", "label": "F2" } },
    { "type": "wokwi-pushbutton", "id": "btn3", "top": 150, "left": -10, "attrs": { "color": "red", "label": "RST" } },
