    [ "led_red:A", "esp:19", "red", [] ],
    [ "led_red:C", "esp:GND.1", "black", [] ],

    [ "led_yellow:A", "esp:18", "yellow", [] ],
    [ "led_yellow:C", "esp:GND.1", "black", [] ],

    [ "btn1:1.l", "esp:13", "green", [] ],
    [ "btn1:2.r", "esp:GND.2", "black", [] ],

    [ "btn2:1.l", "esp:12", "green", [] ],
    [ "btn2:2.r", "esp:GND.2", "black", [] ],

    [ "btn3:1.l", "esp:14", "red", [] ],
    [ "btn3:2.r", "esp:GND.2", "black", [] ],

    [ "buzzer:1", "esp:26", "purple", [] ],
    [ "buzzer:2", "esp:GND.2", "black", [] ],

    [ "pir:OUT", "esp:27", "orange", [] ],
    [ "pir:VCC", "esp:3V3", "red", [] ],
    [ "pir:GND", "esp:GND.2", "black", [] ],

    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:GND", "esp:GND.2", "black", [] ],
    [ "ldr:AO", "esp:34", "yellow", [] ],

    [ "led_blue:A", "esp:5", "blue", [] ],
    [ "led_blue:C", "esp:GND.1", "black", [] ]
